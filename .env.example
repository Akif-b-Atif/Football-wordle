# Copy this file to .env for local development (the app also reads real
# environment variables directly, which is what you'll set on your host).

# Secret used to sign game session tokens. MUST be a long random string
# in production — anyone who has it can forge/inspect game sessions.
JWT_SECRET=change-me-to-a-long-random-string

# Port the server listens on (most hosts set this for you automatically).
PORT=3000

# Path to the player data CSV. Defaults to ./data/players.csv
DATA_FILE=./data/players.csv

# Only needed if you host the frontend separately from the API.
# ALLOW_ORIGIN=https://your-frontend-domain.com
